.{
    .runs = 3,
    .connections = 100,
    .threads = 2,
    .duration_s = 10,
    // Target offered rate (req/s). achieved_rate is what we report as RPS.
    .rate = 200000,
    .port = 8081,
    .timeout_s = 2,
    .frameworks = .{ "zap", "httpz", "zzz", "zinc", "std" },
    .scenarios = .{
        .{
            .id = "plaintext",
            .label = "Plaintext",
            .description = "Minimal OK response — peak request throughput",
            .path = "/httpz",
            .method = "GET",
        },
        .{
            .id = "json",
            .label = "JSON",
            .description = "Serialize a small JSON user list",
            .path = "/api/users",
            .method = "GET",
        },
    },
}
