const github_url = "https://github.com/zig-bd/bench";

pub fn Header(allocator: zx.Allocator) zx.Component {
    return (
        <div @allocator={allocator} class="header">
            <div class="header-title">
                <ZigLogo />
                Zig Web Servers
            </div>
            <div class="header-actions">
                <SaveChartButton @rendering={.client} />
                <a class="github-info" href={github_url} target="_blank" rel="noopener noreferrer" aria-label="GitHub repository">
                    <GitHubIcon />
                </a>
                <a style="display: none;" class="github-info github-stars" href={github_url} target="_blank" rel="noopener noreferrer">
                    <img
                        src=`https://img.shields.io/{github_url["https://".len..]}/stars?style=flat&label=Stars&labelColor=111827&color=f7a41d&cacheSeconds=60`
                        alt="GitHub stars"
                        width="86"
                        height="20"
                    />
                </a>
                <div class="website-url" hidden>
                    <span>bench.zig.bd</span>
                </div>
            </div>
        </div>
    );
}

const ZigLogo = @import("./zig_logo.zx").ZigLogo;
const GitHubIcon = @import("./github_icon.zx").GitHubIcon;
pub const SaveChartButton = @import("./save_chart.zx").SaveChartButton;
const zx = @import("zx");
