pub fn StatusIcon(allocator: zx.Allocator, props: struct { status: []const u8 }) zx.Component {
    if (std.mem.eql(u8, props.status, "success")) {
        return (
            <div @allocator={allocator} class="status status-success" aria-label="success">
                <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            </div>
        );
    }
    if (std.mem.eql(u8, props.status, "warning")) {
        return (
            <div @allocator={allocator} class="status status-warning" aria-label="warning">
                <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
            </div>
        );
    }
    return (
        <div @allocator={allocator} class="status status-error" aria-label="error">
            <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
        </div>
    );
}

const std = @import("std");
const zx = @import("zx");
