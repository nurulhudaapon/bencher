const Framework = View.Framework;

pub fn BarColumn(allocator: zx.Allocator, props: struct { fw: Framework, index: usize }) zx.Component {
    const is_winner = props.index == 0;
    const name_class = if (is_winner) "bar-name bar-name-winner" else "bar-name";
    const bar_class = if (is_winner) "bar bar-winner" else "bar";
    const title_class = if (is_winner) "tooltip-title tooltip-title-winner" else "tooltip-title";
    const height_style = std.fmt.allocPrint(allocator, "height: {s}", .{props.fw.height}) catch unreachable;

    return (
        <div @allocator={allocator} class="bar-col">
            <div class="bar-stack">
                <div class="bar-value">{props.fw.rps_label}</div>
                <a class={bar_class} href={props.fw.repo_url} target="_blank" rel="noopener noreferrer" style={height_style}>
                    {if (is_winner) (<div class="bar-bolt">{"⚡"}</div>)}
                    <div class="tooltip">
                        <div class="tooltip-arrow"></div>
                        <div class={title_class}>{props.fw.name}</div>
                        <div class="tooltip-rows">
                            <div class="tooltip-row"><span>Req/sec:</span><span>{props.fw.rps_label}</span></div>
                            <div class="tooltip-row"><span>Avg latency:</span><span>{props.fw.average_label}</span></div>
                            <div class="tooltip-row"><span>Fastest:</span><span>{props.fw.fastest_label}</span></div>
                            <div class="tooltip-row"><span>Slowest:</span><span>{props.fw.slowest_label}</span></div>
                            <div class="tooltip-row"><span>P50:</span><span>{props.fw.p50_label}</span></div>
                            <div class="tooltip-row"><span>P95:</span><span>{props.fw.p95_label}</span></div>
                            <div class="tooltip-row"><span>P99:</span><span>{props.fw.p99_label}</span></div>
                            <div class="tooltip-row"><span>Success rate:</span><span>{props.fw.success_label}</span></div>
                        </div>
                    </div>
                </a>
            </div>
            <div class="bar-label">
                <a class={name_class} href={props.fw.repo_url} target="_blank" rel="noopener noreferrer">
                    <span class="bar-name-text">{props.fw.name}</span>
                    <span class="name-tip">
                        <span class="name-tip-arrow"></span>
                        <span class="name-tip-title">{props.fw.name}</span>
                        <span class="name-tip-rows">
                            <span class="name-tip-row"><span>Version</span><span>{props.fw.version_label}</span></span>
                            <span class="name-tip-row"><span>Language</span><span>{props.fw.language_label}</span></span>
                        </span>
                    </span>
                </a>
            </div>
        </div>
    );
}

const std = @import("std");
const zx = @import("zx");
const View = @import("../View.zig");
