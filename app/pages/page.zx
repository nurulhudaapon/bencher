const results = @import("../results.zon");
const frameworks_raw = results.frameworks;
const comparison_raw = results.comparison;
const scenarios_raw = results.scenarios;
const platforms_raw = results.platforms;
const runs_raw = results.runs;
const meta = results.meta;

const fw_len = @typeInfo(@TypeOf(frameworks_raw)).@"struct".field_names.len;
const scenario_len = @typeInfo(@TypeOf(scenarios_raw)).@"struct".field_names.len;
const platform_len = @typeInfo(@TypeOf(platforms_raw)).@"struct".field_names.len;

const FrameworkMeta = struct {
    name: []const u8,
    version: []const u8,
    version_label: []const u8,
    language_label: []const u8,
    repo_url: []const u8,
};

const Framework = struct {
    name: []const u8,
    version: []const u8,
    version_label: []const u8,
    language_label: []const u8,
    repo_url: []const u8,
    rps: f64,
    rps_label: []const u8,
    height: []const u8,
    average_label: []const u8,
    fastest_label: []const u8,
    slowest_label: []const u8,
    p50_label: []const u8,
    p95_label: []const u8,
    p99_label: []const u8,
    success_label: []const u8,
};

const Scenario = struct {
    id: []const u8,
    label: []const u8,
    description: []const u8,
    path: []const u8,
    method: []const u8,
};

const Platform = struct {
    id: []const u8,
    label: []const u8,
    os: []const u8,
    arch: []const u8,
};

const SwitchOption = struct {
    id: []const u8,
    label: []const u8,
};

const os_options = [_]SwitchOption{
    .{ .id = "linux", .label = "Linux" },
    .{ .id = "macos", .label = "macOS" },
    .{ .id = "windows", .label = "Windows" },
};

const arch_options = [_]SwitchOption{
    .{ .id = "x86_64", .label = "x86" },
    .{ .id = "aarch64", .label = "Arm" },
};

const Run = struct {
    framework: []const u8,
    scenario: []const u8,
    platform: []const u8,
    rps: f64,
    average: f64,
    fastest: f64,
    slowest: f64,
    success_rate: f64,
    latency_p50: f64,
    latency_p95: f64,
    latency_p99: f64,
};

const FeatureCell = struct {
    value: []const u8,
    status: []const u8,
};

const FeatureRow = struct {
    name: []const u8,
    description: []const u8,
    cells: [fw_len]FeatureCell,
};

const Category = struct {
    name: []const u8,
    description: []const u8,
    features: []const FeatureRow,
};

fn formatInt(n: u64) []const u8 {
    if (n >= 1_000_000) {
        const millions = n / 1_000_000;
        const thousands = (n / 1000) % 1000;
        const rem = n % 1000;
        return std.fmt.comptimePrint("{d},{d:0>3},{d:0>3}", .{ millions, thousands, rem });
    }
    if (n >= 1000) {
        return std.fmt.comptimePrint("{d},{d:0>3}", .{ n / 1000, n % 1000 });
    }
    return std.fmt.comptimePrint("{d}", .{n});
}

fn formatRps(allocator: zx.Allocator, rps: f64) []const u8 {
    const n: u64 = @intFromFloat(@round(rps));
    if (n >= 1_000_000) {
        return std.fmt.allocPrint(allocator, "{d},{d:0>3},{d:0>3}", .{ n / 1_000_000, (n / 1000) % 1000, n % 1000 }) catch unreachable;
    }
    if (n >= 1000) {
        return std.fmt.allocPrint(allocator, "{d},{d:0>3}", .{ n / 1000, n % 1000 }) catch unreachable;
    }
    return std.fmt.allocPrint(allocator, "{d}", .{n}) catch unreachable;
}

fn formatMs(allocator: zx.Allocator, seconds: f64) []const u8 {
    return std.fmt.allocPrint(allocator, "{d:.2} ms", .{seconds * 1000.0}) catch unreachable;
}

fn formatPct(allocator: zx.Allocator, rate: f64) []const u8 {
    return std.fmt.allocPrint(allocator, "{d:.1}%", .{rate * 100.0}) catch unreachable;
}

fn barHeight(allocator: zx.Allocator, rps: f64, max: f64) []const u8 {
    if (max <= 0) return "0%";
    return std.fmt.allocPrint(allocator, "{d:.2}%", .{(rps / max) * 100.0}) catch unreachable;
}

fn languageLabel() []const u8 {
    inline for (@typeInfo(@TypeOf(frameworks_raw)).@"struct".field_names) |name| {
        const d = @field(frameworks_raw, name);
        if (std.mem.eql(u8, d.name, "std")) {
            return std.fmt.comptimePrint("Zig {s}", .{d.version});
        }
    }
    return "Zig 0.16.0";
}

fn versionLabel(comptime version: []const u8) []const u8 {
    if (std.mem.eql(u8, version, "master")) return "master";
    return std.fmt.comptimePrint("v{s}", .{version});
}

fn loadFrameworkMetas() [fw_len]FrameworkMeta {
    const lang = languageLabel();
    var out: [fw_len]FrameworkMeta = undefined;
    inline for (@typeInfo(@TypeOf(frameworks_raw)).@"struct".field_names, 0..) |name, i| {
        const d = @field(frameworks_raw, name);
        out[i] = .{
            .name = d.name,
            .version = d.version,
            .version_label = versionLabel(d.version),
            .language_label = lang,
            .repo_url = d.repo_url,
        };
    }
    return out;
}

fn loadScenarios() [scenario_len]Scenario {
    var out: [scenario_len]Scenario = undefined;
    inline for (@typeInfo(@TypeOf(scenarios_raw)).@"struct".field_names, 0..) |name, i| {
        const d = @field(scenarios_raw, name);
        out[i] = .{
            .id = d.id,
            .label = d.label,
            .description = d.description,
            .path = d.path,
            .method = d.method,
        };
    }
    return out;
}

fn loadPlatforms() [platform_len]Platform {
    var out: [platform_len]Platform = undefined;
    inline for (@typeInfo(@TypeOf(platforms_raw)).@"struct".field_names, 0..) |name, i| {
        const d = @field(platforms_raw, name);
        out[i] = .{
            .id = d.id,
            .label = d.label,
            .os = d.os,
            .arch = d.arch,
        };
    }
    return out;
}

fn loadRunsArr() [@typeInfo(@TypeOf(runs_raw)).@"struct".field_names.len]Run {
    @setEvalBranchQuota(200000);
    const n = @typeInfo(@TypeOf(runs_raw)).@"struct".field_names.len;
    var out: [n]Run = undefined;
    inline for (@typeInfo(@TypeOf(runs_raw)).@"struct".field_names, 0..) |name, i| {
        const d = @field(runs_raw, name);
        out[i] = .{
            .framework = d.framework,
            .scenario = d.scenario,
            .platform = d.platform,
            .rps = d.rps,
            .average = d.average,
            .fastest = d.fastest,
            .slowest = d.slowest,
            .success_rate = d.success_rate,
            .latency_p50 = d.latency_p50,
            .latency_p95 = d.latency_p95,
            .latency_p99 = d.latency_p99,
        };
    }
    return out;
}

fn metaFor(name: []const u8) FrameworkMeta {
    for (framework_metas) |m| {
        if (std.mem.eql(u8, m.name, name)) return m;
    }
    return .{
        .name = name,
        .version = "0",
        .version_label = "v0",
        .language_label = languageLabel(),
        .repo_url = "#",
    };
}

fn buildFrameworks(
    allocator: zx.Allocator,
    scenario_id: []const u8,
    platform_id: []const u8,
) []const Framework {
    var list: std.ArrayList(Framework) = .empty;
    var max: f64 = 0;

    for (all_runs) |run| {
        if (!std.mem.eql(u8, run.scenario, scenario_id)) continue;
        if (!std.mem.eql(u8, run.platform, platform_id)) continue;
        const m = metaFor(run.framework);
        list.append(allocator, .{
            .name = m.name,
            .version = m.version,
            .version_label = m.version_label,
            .language_label = m.language_label,
            .repo_url = m.repo_url,
            .rps = run.rps,
            .rps_label = "",
            .height = "",
            .average_label = formatMs(allocator, run.average),
            .fastest_label = formatMs(allocator, run.fastest),
            .slowest_label = formatMs(allocator, run.slowest),
            .p50_label = formatMs(allocator, run.latency_p50),
            .p95_label = formatMs(allocator, run.latency_p95),
            .p99_label = formatMs(allocator, run.latency_p99),
            .success_label = formatPct(allocator, run.success_rate),
        }) catch unreachable;
        if (run.rps > max) max = run.rps;
    }

    const items = list.toOwnedSlice(allocator) catch unreachable;
    std.sort.pdq(Framework, items, {}, struct {
        fn lessThan(_: void, a: Framework, b: Framework) bool {
            return a.rps > b.rps;
        }
    }.lessThan);

    for (items) |*fw| {
        fw.rps_label = formatRps(allocator, fw.rps);
        fw.height = barHeight(allocator, fw.rps, max);
    }
    return items;
}

const framework_metas = loadFrameworkMetas();
const scenarios = loadScenarios();
const platforms = loadPlatforms();
const all_runs_arr = loadRunsArr();
const all_runs: []const Run = &all_runs_arr;

fn scenarioHasRuns(id: []const u8) bool {
    for (all_runs) |run| {
        if (std.mem.eql(u8, run.scenario, id)) return true;
    }
    return false;
}

fn countRunnableScenarios() usize {
    var n: usize = 0;
    for (scenarios) |sc| {
        if (scenarioHasRuns(sc.id)) n += 1;
    }
    return n;
}

const runnable_scenario_len = countRunnableScenarios();

fn loadRunnableScenarios() [runnable_scenario_len]Scenario {
    var out: [runnable_scenario_len]Scenario = undefined;
    var i: usize = 0;
    for (scenarios) |sc| {
        if (!scenarioHasRuns(sc.id)) continue;
        out[i] = sc;
        i += 1;
    }
    return out;
}

const runnable_scenarios = loadRunnableScenarios();

fn osLabel(id: []const u8) []const u8 {
    for (os_options) |opt| {
        if (std.mem.eql(u8, opt.id, id)) return opt.label;
    }
    return id;
}

fn archLabel(id: []const u8) []const u8 {
    for (arch_options) |opt| {
        if (std.mem.eql(u8, opt.id, id)) return opt.label;
    }
    return id;
}

fn cellFor(feature: anytype, fw_name: []const u8) FeatureCell {
    const T = @TypeOf(feature);
    inline for (@typeInfo(T).@"struct".field_names) |name| {
        if (std.mem.eql(u8, name, "name") or std.mem.eql(u8, name, "description"))
            continue;
        if (std.mem.eql(u8, name, fw_name)) {
            const cell = @field(feature, name);
            return .{ .value = cell.value, .status = cell.status };
        }
    }
    return .{ .value = "—", .status = "error" };
}

fn countFeatures(comptime category: anytype) usize {
    return @typeInfo(@TypeOf(category.features)).@"struct".field_names.len;
}

fn loadFeatureRows(comptime category: anytype) [countFeatures(category)]FeatureRow {
    @setEvalBranchQuota(100000);
    var rows: [countFeatures(category)]FeatureRow = undefined;
    inline for (@typeInfo(@TypeOf(category.features)).@"struct".field_names, 0..) |feat_name, i| {
        const feature = @field(category.features, feat_name);
        var cells: [fw_len]FeatureCell = undefined;
        for (framework_metas, 0..) |fw, j| {
            cells[j] = cellFor(feature, fw.name);
        }
        rows[i] = .{
            .name = feature.name,
            .description = feature.description,
            .cells = cells,
        };
    }
    return rows;
}

const core_features = loadFeatureRows(@field(comparison_raw, "0"));
const dx_features = loadFeatureRows(@field(comparison_raw, "1"));

const categories = [_]Category{
    .{
        .name = @field(comparison_raw, "0").category,
        .description = @field(comparison_raw, "0").description,
        .features = &core_features,
    },
    .{
        .name = @field(comparison_raw, "1").category,
        .description = @field(comparison_raw, "1").description,
        .features = &dx_features,
    },
};

const tool_label = meta.tool;
const mode_label = meta.mode;
const platform_label = meta.platform.label;
const threads_label = std.fmt.comptimePrint("{d}", .{meta.config.threads});
const connections_label = std.fmt.comptimePrint("{d}", .{meta.config.connections});
const duration_label = std.fmt.comptimePrint("{d}s", .{meta.config.duration_s});
const rate_label = formatInt(meta.config.rate);
const runs_label = std.fmt.comptimePrint("{d}", .{meta.config.runs});
const colspan_label = std.fmt.comptimePrint("{d}", .{fw_len + 1});
const default_platform = platforms[0].id;
const default_os = platforms[0].os;
const default_arch = platforms[0].arch;

fn StatusIcon(allocator: zx.Allocator, props: struct { status: []const u8 }) zx.Component {
    if (std.mem.eql(u8, props.status, "success")) {
        return (
            <div @allocator={allocator} class="status status-success" aria-label="success">
                <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            </div>
        );
    }
    if (std.mem.eql(u8, props.status, "warning")) {
        return (
            <div @allocator={allocator} class="status status-warning" aria-label="warning">
                <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
            </div>
        );
    }
    return (
        <div @allocator={allocator} class="status status-error" aria-label="error">
            <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
        </div>
    );
}

