    return (
        <svg @allocator={allocator} class="zig-logo" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 153 140" aria-hidden="true">
            <g fill="#f7a41d">
                <g>
                    <polygon points="46,22 28,44 19,30" />
                    <polygon points="46,22 33,33 28,44 22,44 22,95 31,95 20,100 12,117 0,117 0,22" />
                    <polygon points="31,95 12,117 4,106" />
                </g>
                <g>
                    <polygon points="56,22 62,36 37,44" />
                    <polygon points="56,22 111,22 111,44 37,44 56,32" />
                    <polygon points="116,95 97,117 90,104" />
                    <polygon points="116,95 100,104 97,117 42,117 42,95" />
                    <polygon points="150,0 52,117 3,140 101,22" />
                </g>
                <g>
                    <polygon points="141,22 140,40 122,45" />
                    <polygon points="153,22 153,117 106,117 120,105 125,95 131,95 131,45 122,45 132,36 141,22" />
                    <polygon points="125,95 130,110 106,117" />
                </g>
            </g>
        </svg>
    );
}

fn GitHubIcon(allocator: zx.Allocator) zx.Component {
    return (
        <svg @allocator={allocator} class="github-icon" fill="currentColor" role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <title>GitHub</title>
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
        </svg>
    );
}

fn BarColumn(allocator: zx.Allocator, props: struct { fw: Framework, index: usize }) zx.Component {
    const is_winner = props.index == 0;
    const name_class = if (is_winner) "bar-name bar-name-winner" else "bar-name";
    const bar_class = if (is_winner) "bar bar-winner" else "bar";
    const title_class = if (is_winner) "tooltip-title tooltip-title-winner" else "tooltip-title";
    const height_style = std.fmt.allocPrint(allocator, "height: {s}", .{props.fw.height}) catch unreachable;

    return (
        <div @allocator={allocator} class="bar-col">
            <div class="bar-stack">
                <div class="bar-value">{props.fw.rps_label}</div>
                <a class={bar_class} href={props.fw.repo_url} target="_blank" rel="noopener noreferrer" style={height_style}>
                    {if (is_winner) (<div class="bar-bolt">{"⚡"}</div>)}
                    <div class="tooltip">
                        <div class="tooltip-arrow"></div>
                        <div class={title_class}>{props.fw.name}</div>
                        <div class="tooltip-rows">
                            <div class="tooltip-row"><span>Req/sec:</span><span>{props.fw.rps_label}</span></div>
                            <div class="tooltip-row"><span>Avg latency:</span><span>{props.fw.average_label}</span></div>
                            <div class="tooltip-row"><span>Fastest:</span><span>{props.fw.fastest_label}</span></div>
                            <div class="tooltip-row"><span>Slowest:</span><span>{props.fw.slowest_label}</span></div>
                            <div class="tooltip-row"><span>P50:</span><span>{props.fw.p50_label}</span></div>
                            <div class="tooltip-row"><span>P95:</span><span>{props.fw.p95_label}</span></div>
                            <div class="tooltip-row"><span>P99:</span><span>{props.fw.p99_label}</span></div>
                            <div class="tooltip-row"><span>Success rate:</span><span>{props.fw.success_label}</span></div>
                        </div>
                    </div>
                </a>
            </div>
            <div class="bar-label">
                <a class={name_class} href={props.fw.repo_url} target="_blank" rel="noopener noreferrer">
                    <span class="bar-name-text">{props.fw.name}</span>
                    <span class="name-tip">
                        <span class="name-tip-arrow"></span>
                        <span class="name-tip-title">{props.fw.name}</span>
                        <span class="name-tip-rows">
                            <span class="name-tip-row"><span>Version</span><span>{props.fw.version_label}</span></span>
                            <span class="name-tip-row"><span>Language</span><span>{props.fw.language_label}</span></span>
                        </span>
                    </span>
                </a>
            </div>
        </div>
    );
}

fn ChartPanelView(allocator: zx.Allocator, props: struct { panel: Panel }) zx.Component {
    const panel = props.panel;
    const class = if (panel.active) "chart-panel chart-panel-active" else "chart-panel";
    const title = std.fmt.allocPrint(allocator, "HTTP requests per second · {s}", .{panel.scenario.label}) catch unreachable;
    const panel_id = std.fmt.allocPrint(allocator, "panel-{s}-{s}", .{ panel.scenario.id, panel.platform.id }) catch unreachable;

    if (panel.frameworks.len == 0) {
        return (
            <div
                @allocator={allocator}
                class={class}
                id={panel_id}
                data-scenario={panel.scenario.id}
                data-platform={panel.platform.id}
                hidden={!panel.active}
            >
                <h2 class="chart-title">{title}</h2>
                <div class="chart-empty">
                    <p class="chart-empty-title">No results yet</p>
                    <p class="chart-empty-desc">This scenario is configured for future runs. Re-run the Docker bench once the endpoint is implemented.</p>
                </div>
            </div>
        );
    }

    return (
        <div
            @allocator={allocator}
            class={class}
            id={panel_id}
            data-scenario={panel.scenario.id}
            data-platform={panel.platform.id}
            hidden={!panel.active}
        >
            <h2 class="chart-title">{title}</h2>
            <div class="chart-inner">
                <div class="bars">
                    {for (panel.frameworks, 0..) |fw, i| (
                        <BarColumn fw={fw} index={i} />
                    )}
                </div>
            </div>
        </div>
    );
}

fn FeatureRowView(allocator: zx.Allocator, props: struct { row: FeatureRow }) zx.Component {
    return (
        <tr @allocator={allocator} class="feature-row">
            <td>
                <div class="feature-name">{props.row.name}</div>
                <div class="feature-desc">{props.row.description}</div>
            </td>
            {for (props.row.cells) |cell| (
                <td class="cell">
                    <div class="cell-inner">
                        <StatusIcon status={cell.status} />
                        <span class="cell-value">{cell.value}</span>
                    </div>
                </td>
            )}
        </tr>
    );
}

fn CategoryView(allocator: zx.Allocator, props: struct { category: Category, colspan: []const u8 }) zx.Component {
    return (
        <fragment @allocator={allocator}>
            <tr class="category-row">
                <td colspan={props.colspan}>
                    <h3 class="category-title">{props.category.name}</h3>
                    <p class="category-desc">{props.category.description}</p>
                </td>
            </tr>
            {for (props.category.features) |row| (
                <FeatureRowView row={row} />
            )}
        </fragment>
    );
}

