fn fetchResults(ctx: zx.PageContext) !Result {
    const host = ctx.request.headers.get("host") orelse return error.ResultsFetchFailed;
    const url = try std.fmt.allocPrint(ctx.arena, "http://{s}/results.json", .{host});

    var response = (try zx.fetch(zx.Io.blocking, ctx.arena, url, .{})) orelse return error.ResultsFetchFailed;
    defer response.deinit();
    if (!response.ok()) return error.ResultsFetchFailed;

    return zx.util.zxon.parse(Result, ctx.arena, try response.text(), .{});
}

pub fn Page(ctx: zx.PageContext) !zx.Component {
    const allocator = ctx.arena;
    const results = try fetchResults(ctx);
    const catalog = try Frameworks.load(allocator);

    const meta = results.meta;
    const framework_metas = View.buildFrameworkMetas(allocator, catalog.frameworks);
    const runnable_scenarios = View.buildRunnableScenarios(allocator, results.scenarios, results.runs);
    const runnable_platforms = View.buildRunnablePlatforms(allocator, results.platforms, results.runs);
    if (runnable_platforms.len == 0 or runnable_scenarios.len == 0) return error.ResultsIncomplete;

    const available_os = View.buildSwitchOptions(allocator, &View.os_options, runnable_platforms, "os");
    const available_arch = View.buildSwitchOptions(allocator, &View.arch_options, runnable_platforms, "arch");

    const initial_scenario = runnable_scenarios[0];
    const default_platform = runnable_platforms[0].id;
    const default_os = runnable_platforms[0].os;
    const default_arch = runnable_platforms[0].arch;

    const panels = View.buildPanels(allocator, framework_metas, results.runs, runnable_scenarios, runnable_platforms, initial_scenario.id, default_platform);
    const categories = View.buildCategories(allocator, catalog.comparison, framework_metas);
    const labels = View.buildLabels(allocator, meta, framework_metas.len);

    return (
        <div
            @allocator={allocator}
            class="page"
            id="bench-root"
            data-default-scenario={initial_scenario.id}
            data-default-platform={default_platform}
            data-default-os={default_os}
            data-default-arch={default_arch}
        >
            <div class="stage">
                <div class="panel" id="export-root">
                    <Header />

                    <div class="chart">
                        <BenchControls
                            scenarios={runnable_scenarios}
                            available_os={available_os}
                            available_arch={available_arch}
                            initial_scenario_id={initial_scenario.id}
                            default_os={default_os}
                            default_arch={default_arch}
                        />

                        {for (panels) |panel| (
                            <ChartPanel panel={panel} />
                        )}

                        <MachineInfo labels={labels} platform={meta.platform} />
                    </div>
                </div>

                <SideRail panels={panels} />
            </div>

            <ComparisonTable
                frameworks={framework_metas}
                categories={categories}
                colspan={labels.colspan}
            />

            <script @escaping={.none}>{@embedFile("../assets/bench.js")}</script>
            <script @escaping={.none}>{@embedFile("../assets/save_chart.js")}</script>
        </div>
    );
}

const std = @import("std");
const zx = @import("zx");
const Result = @import("../Result.zig");
const Frameworks = @import("../Frameworks.zig");
const View = @import("../View.zig");

const Header = @import("../components/header.zx").Header;
const BenchControls = @import("../components/bench_controls.zx").BenchControls;
const ChartPanel = @import("../components/chart_panel.zx").ChartPanel;
const MachineInfo = @import("../components/machine_info.zx").MachineInfo;
const ComparisonTable = @import("../components/comparison_table.zx").ComparisonTable;
const SideRail = @import("../components/side_rail.zx").SideRail;
pub const SaveChartButton = @import("../components/save_chart.zx").SaveChartButton;
