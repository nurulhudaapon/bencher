    \\    var osCurrent = root.querySelector("[data-os-current]");
    \\    var archCurrent = root.querySelector("[data-arch-current]");
    \\    var osActive = root.querySelector('[data-os-btn="' + os + '"]');
    \\    var archActive = root.querySelector('[data-arch-btn="' + arch + '"]');
    \\    if (osCurrent && osActive) osCurrent.textContent = osActive.textContent.trim();
    \\    if (archCurrent && archActive) archCurrent.textContent = archActive.textContent.trim();
    \\    root.querySelectorAll(".chart-panel").forEach(function (panel) {
    \\      var match = panel.getAttribute("data-scenario") === scenario &&
    \\                  panel.getAttribute("data-platform") === platform;
    \\      panel.classList.toggle("chart-panel-active", match);
    \\      if (match) panel.removeAttribute("hidden");
    \\      else panel.setAttribute("hidden", "");
    \\    });
    \\  }
    \\
    \\  root.querySelectorAll("[data-scenario-tab]").forEach(function (tab) {
    \\    tab.addEventListener("click", function () {
    \\      scenario = tab.getAttribute("data-scenario-tab");
    \\      sync();
    \\    });
    \\  });
    \\  root.querySelectorAll("[data-os-btn]").forEach(function (btn) {
    \\    btn.addEventListener("click", function () {
    \\      os = btn.getAttribute("data-os-btn");
    \\      sync();
    \\      btn.blur();
    \\    });
    \\  });
    \\  root.querySelectorAll("[data-arch-btn]").forEach(function (btn) {
    \\    btn.addEventListener("click", function () {
    \\      arch = btn.getAttribute("data-arch-btn");
    \\      sync();
    \\      btn.blur();
    \\    });
    \\  });
    \\  root.querySelectorAll(".plat-side").forEach(function (side) {
    \\    side.addEventListener("mouseleave", function () {
    \\      var focused = side.querySelector(":focus");
    \\      if (focused) focused.blur();
    \\    });
    \\  });
    \\
    \\  sync();
    \\})();
;

const save_chart_script = @embedFile("../assets/save_chart.js");

pub fn Page(ctx: zx.PageContext) !zx.Component {
    const allocator = ctx.arena;
    const initial_scenario = runnable_scenarios[0];

    return (
        <div
            @allocator={allocator}
            class="page"
            id="bench-root"
            data-default-scenario={initial_scenario.id}
            data-default-platform={default_platform}
            data-default-os={default_os}
            data-default-arch={default_arch}
        >
            <div class="panel" id="export-root">
                <div class="header">
                    <div class="header-title">
                        <ZigLogo />
                        Zig Web Frameworks
                    </div>
                    <div class="header-actions">
                        <a class="github-info" href="https://github.com/nurulhudaapon/bench-zig-web-frameworks" target="_blank" rel="noopener noreferrer" aria-label="GitHub repository">
                            <GitHubIcon />
                        </a>
                        <a class="github-info" href="https://github.com/nurulhudaapon/bench-zig-web-frameworks" target="_blank" rel="noopener noreferrer">
                            <img
                                src="https://img.shields.io/github/stars/nurulhudaapon/bench-zig-web-frameworks?style=social&cacheSeconds=60"
                                alt="GitHub stars"
                                width="88"
                                height="20"
                            />
                        </a>
                        <div class="website-url" hidden>
                            <span>zigweb.nuhu.dev</span>
                        </div>
                    </div>
                </div>

                <div class="chart">
                    <SaveChartButton @rendering={.client} />

                    <div class="bench-controls export-chrome">
                        <div class="control-row" aria-label="Test kind">
                            <div class="seg" role="group" aria-label="Test kind">
                                {for (runnable_scenarios) |sc| (
                                    <button
                                        type="button"
                                        class={if (std.mem.eql(u8, sc.id, initial_scenario.id)) "seg-btn seg-btn-active" else "seg-btn"}
                                        data-scenario-tab={sc.id}
                                        aria-pressed={if (std.mem.eql(u8, sc.id, initial_scenario.id)) "true" else "false"}
                                    >
                                        {sc.label}
                                    </button>
                                )}
                            </div>
                        </div>

                        <div class="control-row" aria-label="Platform">
                            <div class="plat-pill" role="group" aria-label="OS and architecture">
                                <div class="plat-side plat-os">
                                    <span class="plat-current" data-os-current>{osLabel(default_os)}</span>
                                    <div class="plat-menu" role="group" aria-label="Operating system">
                                        {for (os_options) |opt| (
                                            <button
                                                type="button"
                                                class={if (std.mem.eql(u8, opt.id, default_os)) "plat-opt plat-opt-active" else "plat-opt"}
                                                data-os-btn={opt.id}
                                                aria-pressed={if (std.mem.eql(u8, opt.id, default_os)) "true" else "false"}
                                            >
                                                {opt.label}
                                            </button>
                                        )}
                                    </div>
                                </div>
                                <span class="plat-slash" aria-hidden="true">{"/"}</span>
                                <div class="plat-side plat-arch">
                                    <span class="plat-current" data-arch-current>{archLabel(default_arch)}</span>
                                    <div class="plat-menu" role="group" aria-label="CPU architecture">
                                        {for (arch_options) |opt| (
                                            <button
                                                type="button"
                                                class={if (std.mem.eql(u8, opt.id, default_arch)) "plat-opt plat-opt-active" else "plat-opt"}
                                                data-arch-btn={opt.id}
                                                aria-pressed={if (std.mem.eql(u8, opt.id, default_arch)) "true" else "false"}
                                            >
                                                {opt.label}
                                            </button>
                                        )}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    {for (runnable_scenarios) |sc| (
                        for (platforms) |pl| (
                            <ChartPanelView
                                scenario={sc}
                                platform={pl}
                                active={std.mem.eql(u8, sc.id, initial_scenario.id) and std.mem.eql(u8, pl.id, default_platform)}
                            />
                        )
                    )}

                    <div class="machine">
                        <div class="machine-wrap">
                            <div class="machine-trigger">
                                <div class="machine-line">
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                    <span>{platform_label}{" • "}{tool_label}{" • "}{mode_label}</span>
                                </div>
                            </div>
                            <div class="machine-tooltip">
                                <div class="machine-tooltip-arrow"></div>
                                <div class="machine-tooltip-title">Benchmark Environment</div>

                                <div class="machine-section">
                                    <div class="machine-section-label">Load Generator</div>
                                    <div class="machine-grid-2">
                                        <div class="machine-kv"><dt>Tool:</dt><dd>{tool_label}</dd></div>
                                        <div class="machine-kv"><dt>Mode:</dt><dd>{mode_label}</dd></div>
                                        <div class="machine-kv"><dt>Threads:</dt><dd>{threads_label}</dd></div>
                                        <div class="machine-kv"><dt>Connections:</dt><dd>{connections_label}</dd></div>
                                        <div class="machine-kv"><dt>Duration:</dt><dd>{duration_label}</dd></div>
                                        <div class="machine-kv"><dt>Target rate:</dt><dd>{rate_label}</dd></div>
                                        <div class="machine-kv"><dt>Runs:</dt><dd>{runs_label}</dd></div>
                                    </div>
                                </div>

                                <div class="machine-section">
                                    <div class="machine-section-label">Primary Platform</div>
                                    <div class="machine-kv"><dt>Label:</dt><dd>{platform_label}</dd></div>
                                    <div class="machine-kv"><dt>OS:</dt><dd>{meta.platform.os}{" / "}{meta.platform.arch}</dd></div>
                                    <div class="machine-kv"><dt>Kernel:</dt><dd>{meta.platform.os_version}</dd></div>
                                    <div class="machine-kv"><dt>Host:</dt><dd>{meta.platform.hostname}</dd></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="spacer"></div>

            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Feature</th>
                            {for (framework_metas) |fw| (
                                <th class="center">{fw.name}</th>
                            )}
                        </tr>
                    </thead>
                    <tbody>
                        {for (categories) |category| (
                            <CategoryView category={category} />
                        )}
                    </tbody>
                </table>
            </div>

            <script @escaping={.none}>{bench_script}</script>
            <script @escaping={.none}>{save_chart_script}</script>
        </div>
    );
}

const std = @import("std");
const zx = @import("zx");
pub const SaveChartButton = @import("./save_chart.zx").SaveChartButton;
