pub fn Layout(ctx: zx.LayoutContext, children: zx.Component) zx.Component {
    return (
        <html @allocator={ctx.arena} lang="en">
            <head>
                <meta charset="utf-8" />
                <meta name="viewport" content="width=device-width, initial-scale=1" />
                <meta name="description" content="Performance comparison of popular Zig Web Servers including httpz, dusty+std, dusty+zio, zap, zzz, and std.http." />
                <meta name="keywords" content="zig, web frameworks, benchmark, performance, httpz, dusty, zap, std, zzz" />
                <meta name="author" content="Nurul Huda (Apon)" />
                <title>Zig Web Servers Benchmark</title>
                <link rel="icon" href="favicon.svg" type="image/svg+xml" />
                <link rel="preconnect" href="https://fonts.googleapis.com" />
                <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
                <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
                <style @escaping={.none}>{@embedFile("../assets/styles.css")}</style>
            </head>
            <body>
                {children}
            </body>
        </html>
    );
}

const zx = @import("zx");
